<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#1E3A5F" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#2563EB" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="12dp" /><gradient android:angle="0" android:startColor="#3B82F6" android:endColor="#2563EB" /></shape>
    </item>
</selector>
